# 复制成 .env 再改值：cp .env.example .env
# .env 已经在 .dockerignore 里，不会被打进镜像

# 数据库口令：数据库容器与后端都读这一个值。
# 生成办法：openssl rand -base64 24
POSTGRES_PASSWORD=change-me-please

# 员工端登录票据的签名密钥（12 小时有效）
# 生成办法：openssl rand -hex 32
ADC_AUTH_TOKEN_SECRET=change-me-please-32-bytes-hex

# 患者端小程序票据的签名密钥（7 天有效），必须与上面不同
ADC_WX_TOKEN_SECRET=change-me-please-another-32-bytes

# 小程序 AppID / AppSecret（公众平台 → 开发管理 → 开发设置）
# 留空时后端走「本地开发模式」：openid 由 wx.login 的 code 派生，
# 每次登录都是新用户，患者看不到历史预约。做体验版演示必须填齐。
ADC_WX_APP_ID=
ADC_WX_APP_SECRET=

# 对外端口。有域名并上了 HTTPS 后，把这里改成 127.0.0.1:8080 之类的内网入口，
# 让 80 端口只留给反向代理（certbot 需要）
HTTP_PORT=80
